# ADMIN_PASSWORD: mot de passe du panel admin (accessible via /admin).
# OBLIGATOIRE en production : sans lui, l'administration est désactivée.
ADMIN_PASSWORD="choisir-un-mot-de-passe-long"

# SITE_URL: adresse publique définitive du site (sans slash final).
# Utilisée pour les balises canonical, Open Graph, robots.txt et sitemap.xml.
# Si absente, l'adresse de la requête est utilisée.
SITE_URL="https://www.exemple.fr"
